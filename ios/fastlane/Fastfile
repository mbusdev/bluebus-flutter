default_platform(:ios)

platform :ios do
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"]
    )
    match(type: "appstore", readonly: true, api_key: api_key)
    build_number = latest_testflight_build_number(api_key: api_key) + 1
    sh("cd ../.. && flutter build ios --release --no-codesign --build-number=#{build_number}")
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner", export_method: "app-store")
    upload_to_testflight(api_key: api_key, changelog: "PR ##{ENV['PR_NUMBER']}")
  end
end